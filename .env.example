# Copy to .env and fill in. Used by docker-compose.yml.
OPENROUTER_API_KEY=
# OPTIONAL: token that gates GET /api/leads (customer PII). Empty = endpoint disabled.
# Set to a strong random value, e.g. `openssl rand -hex 24`.
LEADS_ADMIN_TOKEN=
# OPTIONAL rate limits (per client IP) for the public LLM-triggering POST endpoints.
# Defaults: 10 calls/min, 30 replies/min. Tune to the demo's real traffic.
RATE_LIMIT_CALL=10/minute
RATE_LIMIT_REPLY=30/minute